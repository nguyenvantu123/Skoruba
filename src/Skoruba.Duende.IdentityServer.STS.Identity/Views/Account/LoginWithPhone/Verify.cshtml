@using Microsoft.AspNetCore.Mvc.Localization
@using Skoruba.Duende.IdentityServer.STS.Identity.Models.Login
@using Skoruba.Duende.IdentityServer.STS.Identity.ViewModels.Account
@using TenantInfrastructure.Abstractions
@inject IViewLocalizer Localizer
@inject ITenantContextAccessor TenantContextAccessor
@model PhoneVerifyViewModel
@{
    ViewData["Title"] = Localizer["LoginWithPhone.Verify.Title"].Value;

    // Read the localized verify-error string set by PhoneLoginController via
    // IStringLocalizer<PhoneLoginController> (Requirement 5.9, 9.5). The view
    // does not call @Localizer["LoginWithPhone.GenericVerifyError"] anymore;
    // it just renders whatever the controller placed under the existing key.
    var verifyError = ViewData["PhoneOtpVerifyError"] as string;
    var resendSuccess = (ViewData["PhoneOtpResendSuccess"] as bool?) ?? false;
    var generatedOtp = ViewData["PhoneOtpGeneratedOtp"] as string;

    var cooldown = Model?.ResendCooldownRemainingSeconds ?? 0;
    var resendDisabled = cooldown > 0;

    var returnUrl = Model?.ReturnUrl ?? string.Empty;

    // Preserve the existing back-link contract verbatim (Requirement 3.7, 9.1):
    // bare `/Account/Login` when no returnUrl, else round-trip the returnUrl
    // through Uri.EscapeDataString so query parameters survive.
    var loginHref = string.IsNullOrEmpty(returnUrl)
        ? "/Account/Login"
        : "/Account/Login?returnUrl=" + Uri.EscapeDataString(returnUrl);

    var headerModel = new LoginShellHeaderModel
    {
        CurrentPath = Context.Request.Path.HasValue ? Context.Request.Path.Value : "/",
        CurrentQuery = Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : string.Empty
    };
}

@section styles {
    <link rel="stylesheet" href="~/css/login-tabs.css" asp-append-version="true" />
}

@section scripts {
    <script src="~/js/phone-verify-countdown.js" defer asp-append-version="true"></script>
    <script src="~/js/phone-verify-submit.js" defer asp-append-version="true"></script>
}

<div class="login-shell login-shell--gradient">
    <div class="login-shell__lang-floating">
        @await Html.PartialAsync("Common/_LoginLanguageSwitcher", headerModel)
    </div>

    <main class="login-shell__main">
        <section class="verify-shell__hero">
            <div class="verify-shell__badge">
                <lucideicon name="shield-check" class="h-5 w-5" aria-hidden="true" />
            </div>
            <h1 class="login-shell__title">
                @Localizer["LoginWithPhone.Verify.Title"]
            </h1>
            <p class="login-shell__subtitle">
                @Localizer["LoginWithPhone.Verify.Subtitle"]
            </p>
            <div class="verify-shell__phone-chip" id="phoneOtpMaskedPhone">
                <span class="verify-shell__phone-chip-label">@Localizer["LoginWithPhone.MaskedPhonePrefix"]</span>
                <strong class="verify-shell__phone-chip-value">@Model?.MaskedPhone</strong>
            </div>
        </section>

        @if (TenantContextAccessor.Current != null)
        {
            @await Html.PartialAsync("Common/_LoginTenantPill")
        }

        <div class="card login-card verify-shell__card">
            <div class="card-content verify-shell__card-content">
                @if (resendSuccess)
                {
                    <div class="alert alert-success" role="alert">
                        @Localizer["LoginWithPhone.Resend"]
                    </div>
                }

                <div class="alert alert-danger @(!string.IsNullOrEmpty(verifyError) ? string.Empty : "hidden")"
                     role="alert"
                     data-phone-otp-verify-error="true"
                     aria-live="polite">
                    @verifyError
                </div>

                @if (!string.IsNullOrWhiteSpace(generatedOtp))
                {
                    <div class="verify-shell__dev-otp" role="status">
                        <div class="verify-shell__dev-otp-label">SMS delivery disabled</div>
                        <div class="verify-shell__dev-otp-code">@generatedOtp</div>
                        <div class="verify-shell__dev-otp-help">Use this OTP to complete the phone login flow without sending a real SMS.</div>
                    </div>
                }

                <form method="post"
                      action="/Account/LoginWithPhone/Verify"
                      novalidate
                      class="verify-shell__form"
                      id="phoneOtpVerifyForm">
                    @Html.AntiForgeryToken()

                    <div class="form-item verify-shell__otp-field">
                        <label class="form-label" for="phoneOtpCode">
                            @Localizer["LoginWithPhone.OtpLabel"]
                        </label>
                        <div class="input-with-icon relative">
                            <lucideicon name="key" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" aria-hidden="true" />
                            <input type="text"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   id="phoneOtpCode"
                                   name="Otp"
                                   class="input pl-10"
                                   maxlength="@(Model?.OtpLength ?? 6)"
                                   aria-describedby="phoneOtpMaskedPhone"
                                   required
                                   autofocus />
                        </div>
                        <p class="verify-shell__otp-hint">
                            @Localizer["LoginWithPhone.MaskedPhonePrefix"] <strong>@Model?.MaskedPhone</strong>
                        </p>
                    </div>

                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                    <button type="submit"
                            class="btn-gradient-primary verify-shell__primary-action"
                            data-phone-otp-verify-submit="true">
                        @Localizer["LoginWithPhone.VerifySubmit"]
                    </button>
                </form>

                <form method="post" action="/Account/LoginWithPhone/Resend" novalidate class="verify-shell__secondary-actions">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                    @if (resendDisabled)
                    {
                        <button type="submit"
                                class="btn-link verify-shell__resend-link disabled:opacity-60 disabled:cursor-not-allowed"
                                data-resend-button="true"
                                data-resend-label="@Localizer["LoginWithPhone.Resend"]"
                                data-cooldown-seconds="@cooldown"
                                disabled
                                aria-disabled="true">
                            <span data-resend-text="true">@Localizer["LoginWithPhone.Resend"] (@cooldown s)</span>
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn-link verify-shell__resend-link"
                                data-resend-button="true"
                                data-resend-label="@Localizer["LoginWithPhone.Resend"]"
                                data-cooldown-seconds="0"
                                aria-disabled="false">
                            <span data-resend-text="true">@Localizer["LoginWithPhone.Resend"]</span>
                        </button>
                    }
                </form>

                <p class="verify-shell__back-link-wrap">
                    <a href="@loginHref" class="verify-shell__back-link">
                        @Localizer["LoginWithPhone.BackToLogin"]
                    </a>
                </p>
            </div>
        </div>

        @await Html.PartialAsync("Common/_LoginFooter")
    </main>
</div>
