{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "MobileBff": {
    "Authentication": {
      "Authority": "",
      "RequireHttpsMetadata": true,
      "Audience": null
    },
    "TenantClientCache": {
      "BaseAddress": "",
      "ApiKey": "",
      "HttpTimeoutSeconds": 5,
      "MaxRetryAttempts": 2,
      "MaxClientCacheTtlSeconds": 300
    },
    "RateLimiting": {
      "BootstrapPermitLimit": 10,
      "BootstrapWindowSeconds": 60,
      "BootstrapQueueLimit": 0
    }
  }
}
