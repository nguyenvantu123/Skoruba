# Copy this file to `.env` next to update-whitelist.ps1 and fill in real values.
# `.env` is gitignored. NEVER commit AccessKey to git.

# Aliyun RAM AccessKey (use a RAM user limited to ModifySecurityIps on the
# specific instances only). Do NOT use the root AccessKey.
ALIYUN_ACCESS_KEY_ID=LTAI...
ALIYUN_ACCESS_KEY_SECRET=...

# ---- RDS target ----
# Region matches the suffix of the connection string host
# (e.g. mysql.singapore.rds.aliyuncs.com -> ap-southeast-1).
ALIYUN_RDS_INSTANCE_ID=rm-gs50m8i4y99y7t087ko
ALIYUN_RDS_REGION_ID=ap-southeast-1
# Dedicated whitelist group; create it once in the Aliyun Console (RDS ->
# instance -> Whitelist Settings -> Add a Whitelist Group). Leave initially
# empty. The script overwrites this group only.
ALIYUN_RDS_GROUP_NAME=dev_dynamic

# ---- Redis (KVStore) target. Optional. Leave instance id blank to skip. ----
# Region matches the suffix of the Redis connection host
# (e.g. r-xxx.redis.singapore.rds.aliyuncs.com -> ap-southeast-1).
ALIYUN_REDIS_INSTANCE_ID=r-gs5ikwkbfv6lktajt7
ALIYUN_REDIS_REGION_ID=ap-southeast-1
# Aliyun KVStore exposes a single SecurityIpGroup named `default` out of the
# box. You can create extra groups in the Console (Whitelist Settings -> Add
# a Whitelist Group) and put the dev_dynamic name here. Defaults to `default`
# if left empty.
ALIYUN_REDIS_GROUP_NAME=dev_dynamic

# Optional public-IP probe. Defaults to https://api.ipify.org.
# PUBLIC_IP_PROBE_URL=https://api.ipify.org
